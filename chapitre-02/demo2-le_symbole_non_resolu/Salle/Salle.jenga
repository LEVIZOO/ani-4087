#!/usr/bin/env python3
# -*- coding: utf-8 -*-

from Jenga import *

with workspace("Salle"):
    configurations(['Debug', 'Release'])
    targetoses([TargetOS.WINDOWS, TargetOS.LINUX, TargetOS.MACOS])
    targetarchs([TargetArch.X86_64])

    with project("MaSalle"):
        consoleapp()
        language("C++")
        location("MaSalle")
        includedirs(["include"])
        files(["src/main.cpp", "src/ModuleA.cpp", "include/**.hpp"])
